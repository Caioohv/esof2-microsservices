generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  LOJISTA
  CLIENTE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  type      UserType @default(CLIENTE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
