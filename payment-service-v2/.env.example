PORT=3003

# Prisma / MySQL — substitui DB_HOST/DB_USER/etc separados
DATABASE_URL="mysql://root:secret@mysql:3306/payment_db"

# Auth service
AUTH_SERVICE_URL=http://auth-service:3001

# Stripe (deixe em branco para modo mock)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL base do serviço (redirects do Stripe)
BASE_URL=http://localhost:3003
