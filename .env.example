# Banco de dados (um Postgres, três bancos: auth_db, user_db, store_db)
DB_ROOT_PASSWORD=secret

# JWT (auth-service)
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production

# Origem do front liberada no CORS do auth-service (opcional agora que o webapp faz o proxy)
WEB_ORIGIN=https://olimposhowcase.com.br

# Usados pelo docker-compose.prod.yml no deploy (preenchidos pelo CI)
GHCR_OWNER=caioohv
IMAGE_TAG=latest
